# ─────────────────────────────────────────────────────────────
#  CEPAT — Environment Variables Example
#  Salin file ini ke .env dan isi nilainya
# ─────────────────────────────────────────────────────────────

# ── BMKG API ──────────────────────────────────────────────────
BMKG_TIMEOUT=10

# ── MONITORING AGENT ──────────────────────────────────────────
POLL_INTERVAL=300
MAGNITUDE_THRESHOLD=5.0

# ── GEMINI / GOOGLE AI ────────────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_HOAX_MODEL=gemini-2.0-flash
GEMINI_ANALYSIS_MODEL=gemini-2.0-flash
GEMINI_COMM_MODEL=gemini-2.0-flash
GEMINI_COORD_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=1500

# ── RSS FEEDS ─────────────────────────────────────────────────
RSS_TIMEOUT=8
RSS_MAX_AGE_HOURS=24

# ── TELEGRAM MONITORING (T2.6) ────────────────────────────────
# Diperoleh dari https://my.telegram.org/apps (gratis)
# Biarkan kosong untuk skip Telegram monitoring
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_MAX_MSGS=20
TELEGRAM_SESSION_DIR=database

# ── PIPELINE / ORCHESTRATOR ───────────────────────────────────
PIPELINE_MIN_MAGNITUDE=5.0
PIPELINE_MAX_INTEL=10

# ── DATABASE ──────────────────────────────────────────────────
DATABASE_PATH=database/cepat.db

# ── FLASK DASHBOARD ───────────────────────────────────────────
# GANTI dengan secret key acak yang panjang di produksi!
FLASK_SECRET_KEY=ganti-dengan-secret-key-acak-panjang-di-produksi
FLASK_DEBUG=False
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# ── OPERATOR AUTH (T2.3) ──────────────────────────────────────
# Password untuk akun operator hardcoded
# Default: admin=password_bpbd_2025, operator1=gempa123, operator2=cepat456
OPERATOR_ADMIN_PASS=password_bpbd_2025
OPERATOR1_PASS=gempa123
OPERATOR2_PASS=cepat456
