# ─────────────────────────────────────────────────────────────
#  CEPAT — Environment Variables
#  Salin file ini menjadi .env dan isi nilainya
# ─────────────────────────────────────────────────────────────

# ── Monitoring Agent ─────────────────────────────────────────
POLL_INTERVAL=300          # Interval polling BMKG dalam detik (default: 300 = 5 menit)
MAGNITUDE_THRESHOLD=5.0    # Batas magnitudo untuk alert (default: 5.0)
BMKG_TIMEOUT=10            # Timeout request ke BMKG dalam detik

# ── Gemini / Google API  (WAJIB untuk Fase 2) ────────────────
GEMINI_API_KEY=AIza...          # Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_HOAX_MODEL=gemini-2.0-flash
GEMINI_ANALYSIS_MODEL=gemini-2.0-flash
GEMINI_COMM_MODEL=gemini-2.0-flash
GEMINI_COORD_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=1500

# ── Intelligence Agent ────────────────────────────────────────
RSS_TIMEOUT=8
RSS_MAX_AGE_HOURS=24       # Ambil berita maks 24 jam yang lalu

# ── Pipeline / Orchestrator ───────────────────────────────────
PIPELINE_MIN_MAGNITUDE=5.0
PIPELINE_MAX_INTEL=10      # Maks artikel per gempa yang diproses

# ── Database ─────────────────────────────────────────────────
DATABASE_PATH=database/cepat.db

# ── Flask Dashboard ───────────────────────────────────────────
FLASK_SECRET_KEY=ganti-dengan-kunci-rahasia-yang-kuat
FLASK_DEBUG=False
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
